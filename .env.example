# Copy to .env (never commit .env). All values below are the defaults.
# Listen on loopback; expose via a reverse proxy (nginx/Caddy) or tunnel.
CUPPA_BIND=127.0.0.1:8080
# Public URL printed in QR codes. Use https:// in production (turns on Secure cookies + HSTS).
CUPPA_PUBLIC_URL=http://localhost:8080
DATABASE_URL=sqlite://data/cuppa.db
# Only when behind YOUR reverse proxy that appends X-Forwarded-For.
CUPPA_TRUST_PROXY=false
CUPPA_TZ_OFFSET_HOURS=7
RUST_LOG=cuppa=info
